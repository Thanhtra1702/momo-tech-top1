# Sao chép thành .env và điền khóa thật. Không commit file .env.
# Backend tự đọc file .env ở thư mục gốc dự án. Trên nơi deploy, đặt các biến này trong phần Environment.

# --- LLM (bắt buộc LLM_API_KEY) ---
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TIMEOUT_S=60

# --- Ứng dụng ---
DB_PATH=data/app.db
# Tài khoản dùng thử cho ban giám khảo: "tên:mật khẩu,tên:mật khẩu". Đổi mật khẩu khi deploy thật.
DEMO_USERS=demo1:momo2026,demo2:momo2026,demo3:momo2026
# Rỗng thì tắt endpoint /admin/costs. Đặt chuỗi dài ngẫu nhiên nếu muốn xem chi phí.
ADMIN_TOKEN=

# --- Giới hạn và chi phí ---
# Đặt false nếu DeepSeek không nhận ảnh (kết quả thử ở docs/deepseek-spike.md). Nút gửi ảnh sẽ ẩn.
IMAGES_ENABLED=true
MAX_AGENT_STEPS=6
RATE_LIMIT_PER_MIN=12
DAILY_COST_CAP_USD=5
USER_DAILY_COST_CAP_USD=1
