{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tour",
  "title": "Tour",
  "type": "object",
  "required": ["id", "name", "city", "duration_days", "price_per_person_vnd", "slots_left", "rating", "deeplink"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^tur_[a-z0-9_]+$"},
    "name": {"type": "string", "minLength": 1},
    "city": {"type": "string"},
    "duration_days": {"type": "number", "minimum": 0.5},
    "price_per_person_vnd": {"type": "integer", "minimum": 0},
    "slots_left": {"type": "integer", "minimum": 0},
    "rating": {"type": "number", "minimum": 0, "maximum": 5},
    "highlights": {"type": "array", "items": {"type": "string"}},
    "departs_on": {"type": "string", "format": "date"},
    "deeplink": {"type": "string", "format": "uri"}
  }
}
